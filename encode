#!/usr/bin/env python3
"""
mdqr_encode.py: pack Markdown files into a set of numbered QR codes (fully offline).

    python mdqr_encode.py notes.md guide.md             # specific files
    python mdqr_encode.py my_folder/                    # every .md in a folder
    python mdqr_encode.py my_folder/ --density max      # fewest codes, densest

How it squeezes the most in:
  1. All files are bundled into one blob (so they compress together).
  2. Compressed with Brotli or LZMA, whichever needs fewer codes.
  3. Encoded as Base45, which fits QR "alphanumeric" mode, about 23% denser
     than Base64 and safe to copy/paste as text from a phone.
  4. Split into numbered parts with a checksum, so parts can be scanned in any
     order and damage is detected.

Output (in ./qr_output by default):
  viewer.html      open offline in a browser: shows codes one by one, full screen,
                   or prints them all on a sheet
  part_00_decoder  the unpacking script itself, as a QR code (byte mode)
  part_01..NN      the data codes (PNG with labels if Pillow is installed, else SVG)

Setup:  pip install qrcode pillow brotli      (pillow and brotli are optional)
"""

import argparse
import html
import io
import json
import lzma
import sys
import zlib
from pathlib import Path

import qrcode
from qrcode.image.svg import SvgPathImage
from qrcode.util import QRData, MODE_ALPHA_NUM, MODE_8BIT_BYTE

try:
    import brotli
except ImportError:
    brotli = None

HERE = Path(__file__).resolve().parent
B45 = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ $%*+-./:"

# Alphanumeric characters that fit at error-correction level L, versions 1-40.
ALNUM_L = [25, 47, 77, 114, 154, 195, 224, 279, 335, 395, 468, 535, 619, 667, 758,
           854, 938, 1046, 1153, 1249, 1352, 1460, 1588, 1704, 1853, 1990, 2132,
           2223, 2369, 2520, 2677, 2840, 3009, 3183, 3351, 3537, 3729, 3927, 4087, 4296]
DENSITY = {"easy": 20, "normal": 25, "dense": 30, "max": 40}   # QR version


def b45encode(data: bytes) -> str:
    out = []
    for i in range(0, len(data), 2):
        chunk = data[i:i + 2]
        n = int.from_bytes(chunk, "big")
        digits = 3 if len(chunk) == 2 else 2
        for _ in range(digits):
            out.append(B45[n % 45])
            n //= 45
    return "".join(out)


def gather(paths):
    files = []
    for p in map(Path, paths):
        if p.is_dir():
            files += [(f, f.relative_to(p)) for f in sorted(p.rglob("*.md"))]
        elif p.is_file():
            files.append((p, Path(p.name)))
        else:
            sys.exit(f"Not found: {p}")
    if not files:
        sys.exit("No .md files found.")
    bundle = {}
    for f, rel in files:
        try:
            bundle[rel.as_posix()] = f.read_bytes().decode("utf-8")
        except UnicodeDecodeError:
            sys.exit(f"{f} is not UTF-8 text.")
    return bundle


def split(payload: str, method: str, crc: str, version: int):
    cap = ALNUM_L[version - 1]
    # Header e.g. "MDQR PART 3/16 B 1A2B3C4D 1830 ". It must NOT start with
    # "letters:" or iPhones treat the code as a link with an unknown scheme
    # and report "No usable data found".
    n = 1
    while True:
        header_len = len(f"MDQR PART {n}/{n} {method} {crc} {cap} ")
        size = cap - header_len
        need = -(-len(payload) // size)
        if need <= n:
            break
        n = need
    chunks = [payload[i:i + size] for i in range(0, len(payload), size)]
    total = len(chunks)
    return [f"MDQR PART {i}/{total} {method} {crc} {len(c)} {c}" for i, c in enumerate(chunks, 1)]


def make_qr(text: str, mode, max_version=40):
    qr = qrcode.QRCode(error_correction=qrcode.constants.ERROR_CORRECT_L, border=4, box_size=8)
    qr.add_data(QRData(text.encode("utf-8") if mode == MODE_8BIT_BYTE else text, mode=mode))
    qr.make(fit=True)
    if qr.version > max_version:
        raise RuntimeError(f"Code needed version {qr.version}, expected ≤ {max_version}")
    return qr


def save_image(qr, out_dir: Path, stem: str, label: str) -> Path:
    try:
        from PIL import Image, ImageDraw, ImageFont
    except ImportError:
        path = out_dir / f"{stem}.svg"
        qr.make_image(image_factory=SvgPathImage).save(path)
        return path
    img = qr.make_image(fill_color="black", back_color="white").convert("RGB")
    pad = 70
    canvas = Image.new("RGB", (img.width, img.height + pad), "white")
    canvas.paste(img, (0, 0))
    draw = ImageDraw.Draw(canvas)
    try:
        font = ImageFont.load_default(size=36)
    except TypeError:            # Pillow < 10.1
        font = ImageFont.load_default()
    w = draw.textlength(label, font=font)
    draw.text(((img.width - w) / 2, img.height - 10), label, fill="black", font=font)
    path = out_dir / f"{stem}.png"
    canvas.save(path)
    return path


def svg_string(qr) -> str:
    buf = io.BytesIO()
    qr.make_image(image_factory=SvgPathImage).save(buf)
    s = buf.getvalue().decode("utf-8")
    return s[s.index("<svg"):]


def write_viewer(out_dir: Path, slides, summary: str):
    items = "\n".join(
        f'<figure class="slide" data-i="{i}"><div class="qr">{svg}</div>'
        f'<figcaption><strong>{html.escape(title)}</strong><span>{html.escape(sub)}</span></figcaption></figure>'
        for i, (title, sub, svg) in enumerate(slides))
    page = VIEWER.replace("{{SLIDES}}", items).replace("{{SUMMARY}}", html.escape(summary)) \
                 .replace("{{COUNT}}", str(len(slides)))
    (out_dir / "viewer.html").write_text(page, encoding="utf-8")


def main():
    ap = argparse.ArgumentParser(description="Pack Markdown files into numbered QR codes.")
    ap.add_argument("inputs", nargs="+", help=".md files and/or folders")
    ap.add_argument("--density", choices=DENSITY, default="normal",
                    help="easy=more, smaller codes; max=fewest, densest codes (default: normal)")
    ap.add_argument("--stdlib", action="store_true",
                    help="use LZMA only, so recipients don't need 'pip install brotli'")
    ap.add_argument("--no-decoder", action="store_true", help="don't include the decoder QR code")
    ap.add_argument("-o", "--out", type=Path, default=Path("qr_output"))
    args = ap.parse_args()

    bundle = gather(args.inputs)
    raw = json.dumps(bundle, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    version = DENSITY[args.density]

    candidates = {"X": lzma.compress(raw, format=lzma.FORMAT_RAW, filters=[
        {"id": lzma.FILTER_LZMA2, "preset": 9 | lzma.PRESET_EXTREME}])}
    if brotli and not args.stdlib:
        candidates["B"] = brotli.compress(raw, quality=11, lgwin=24)

    plans = {}
    for method, blob in candidates.items():
        crc = f"{zlib.crc32(blob):08X}"
        plans[method] = (blob, split(b45encode(blob), method, crc, version))
    # Brotli only if it actually saves a code (it makes recipients install a module).
    method = "X"
    if "B" in plans and len(plans["B"][1]) < len(plans["X"][1]):
        method = "B"
    blob, parts = plans[method]

    args.out.mkdir(parents=True, exist_ok=True)
    for old in args.out.glob("part_*"):
        old.unlink()

    slides = []
    total = len(parts)
    if not args.no_decoder:
        decoder = (HERE / "mdqr_decode.py").read_text(encoding="utf-8")
        qr = make_qr(decoder, MODE_8BIT_BYTE)
        save_image(qr, args.out, "part_00_decoder", "Decoder: save as mdqr_decode.py")
        slides.append(("Decoder", "Copy the text and save it as mdqr_decode.py · "
                       "iPhone: use Code Scanner, not Camera", svg_string(qr)))
    for i, text in enumerate(parts, 1):
        qr = make_qr(text, MODE_ALPHA_NUM, version)
        save_image(qr, args.out, f"part_{i:02d}", f"Part {i} of {total}")
        slides.append((f"Part {i} of {total}", "Copy the text into one note · "
                       "iPhone: use Code Scanner, not Camera", svg_string(qr)))

    algo = {"B": "Brotli", "X": "LZMA"}[method]
    lines = sum(len(t.splitlines()) for t in bundle.values())
    summary = (f"{len(bundle)} file(s), {lines:,} lines, {len(raw):,} bytes → "
               f"{len(blob):,} bytes with {algo} ({len(raw) / len(blob):.1f}x) → {total} data code(s)")
    write_viewer(args.out, slides, summary)

    print(summary)
    if method == "B":
        print("Note: uses Brotli, so recipients need 'pip install brotli' "
              "(use --stdlib to avoid that).")
    print(f"Open {args.out / 'viewer.html'} to show or print the codes.")


